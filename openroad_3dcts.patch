+++ b/src/cts/src/CtsOptions.h	1970-01-01 00:00:00.000000000 +0000
@@ -67,6 +67,13 @@
   void resetBufferList() { bufferList_.clear(); }
   void setDbUnits(int units) { dbUnits_ = units; }
   int getDbUnits() const { return dbUnits_; }
+  // V85_TARP: SDC-derived clock period (ns), set by TritonCTS::runTritonCts().
+  // TARP uses this as the default T_period for its slack filter and w_timing
+  // normalization. Historical bug: when CTS_CLOCK_PERIOD_NS was unset, a fixed
+  // 1.0ns default mis-scaled both for every design (filter ~no-op on asap7,
+  // over-tight on slow ng45 designs). Env var still overrides when set.
+  void setSdcPeriodNs(double p) { sdcPeriodNs_ = p; }
+  double getSdcPeriodNs() const { return sdcPeriodNs_; }
   void setWireSegmentUnit(unsigned wireSegmentUnit)
   {
     wireSegmentUnit_ = wireSegmentUnit;
@@ -416,6 +423,8 @@
   bool sinkBufferMaxCapDerateSet_ = false;
   double sinkBufferMaxCapDerateDefault_ = 0.01;
   double sinkBufferMaxCapDerate_ = sinkBufferMaxCapDerateDefault_;
+  // V85_TARP: SDC clock period in ns (0 = unknown; TARP then falls back to 1.0)
+  double sdcPeriodNs_ = 0.0;
   bool dummyLoad_ = true;
   float delayBufferDerate_ = 1.0;  // no derate
   std::string ctsLibrary_;
