+  // Write to CSV (same format as Tcl/Verilog version)
+  extractor.writeIOCSV(io_edges, output_file);
+
+  logger_->report("==========================================");
+  logger_->report("BUF_MACRO: IO extraction complete!");
+  logger_->report("Output written to: {}", output_file);
+  logger_->report("==========================================");
+}
