+      macroFlatMax = std::atoi(e);
+    }
+    const int nSinks = static_cast<int>(topLevelSinks.size());
+    if (type_ == TreeType::MacroTree && macroFlatMax > 0 && nSinks <= macroFlatMax) {
+      // Verify all sinks are block (SRAM/macro) instances
