+
+struct TarpParams {
+  double alpha = 0.7;
+  unsigned max_cluster_size = 10;
+  double max_diameter = 100.0;   // in wireSegmentUnit (not um)
+  double d_buf = 0.012;
+  int max_depth = 3;
+  int top_k_edges = 30;
+  double slack_threshold_ratio = 0.3;
+  int fm_max_passes = 10;
+  double balance_ratio = 0.6;
+  int min_ffs_for_tarp = 50;
