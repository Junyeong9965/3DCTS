+            }
+          }
+          logger_->info(CTS, 694,
+              "Fix G: tier {} added {} macro sinks {} '{}'",
+              tier, nSinks,
+              crossTier ? "via sub-root to" : "directly to shared root",
+              crossTier ? (tierPrefix_ + "clkbuf_macro_subroot_"
